# Collector overrides; paths are relative to the project directory.
OPP_USER_AGENT="OpportunityShortsBot/0.1 (+mailto:you@example.com)"
OPP_DB_PATH="data/opportunities.db"

# Local Ollama script generation; no paid API key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Required only for API uploads: Google Cloud OAuth Desktop application JSON.
# YOUTUBE_CLIENT_SECRETS_FILE=secrets/client_secret.json

# Local OAuth token written by python -m shorts auth. Never share or commit it.
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# LinkedIn company page; requires approved Community Management API access.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ORGANIZATION_URN=urn:li:organization:123456
# LINKEDIN_API_VERSION=202609
# LINKEDIN_TOKEN_FILE=secrets/linkedin_token.json

# Buffer company-page publishing (alternative to direct LinkedIn OAuth).
BUFFER_API_KEY=
# BUFFER_ORGANIZATION_ID=
# BUFFER_CHANNEL_ID=
